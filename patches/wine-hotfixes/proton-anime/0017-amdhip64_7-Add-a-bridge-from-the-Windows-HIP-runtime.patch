+/* find the D3D adapter LUID so the unix side can stamp it into the HIP
+ * device properties (ROCm reports none, defeating apps' same-GPU checks) */
+static UINT64 get_dxgi_adapter_luid( BOOL *valid )
+{
+    static UINT64 cached_luid;
+    static int cached_state;  /* 0 = untried, 1 = found, -1 = failed */
+
+    if (!cached_state)
+    {
+        HRESULT (WINAPI *create_factory)( const GUID *riid, void **factory );
+        void *factory = NULL, *adapter = NULL;
+        HMODULE dxgi = GetModuleHandleW( L"dxgi.dll" );
+
+        cached_state = -1;
+        if (!dxgi) dxgi = LoadLibraryW( L"dxgi.dll" );
+        if (dxgi && (create_factory = (void *)GetProcAddress( dxgi, "CreateDXGIFactory1" )))
+        {
+            static const GUID iid_factory1 = {0x770aae78,0xf26f,0x4dba,{0xa8,0x29,0x25,0x3c,0x83,0xd1,0xb3,0x87}};
+            if (SUCCEEDED(create_factory( &iid_factory1, (void **)&factory )))
+            {
+                /* IDXGIFactory1::EnumAdapters1 slot 12, IDXGIAdapter1::GetDesc1 slot 10 */
+                HRESULT (WINAPI *enum_adapters1)( void *, UINT, void ** ) = (*(void ***)factory)[12];
+                UINT i;
+                for (i = 0; cached_state < 0 && enum_adapters1( factory, i, &adapter ) == S_OK; i++)
+                {
+                    struct  /* DXGI_ADAPTER_DESC1 */
+                    {
+                        WCHAR desc[128];
+                        UINT vendor_id, device_id, subsys_id, revision;
+                        SIZE_T mem[3];
+                        UINT64 luid;
+                        UINT flags;
+                    } desc;
+                    HRESULT (WINAPI *get_desc1)( void *, void * ) = (*(void ***)adapter)[10];
+                    if (SUCCEEDED(get_desc1( adapter, &desc )) && !(desc.flags & 2 /* SOFTWARE */))
+                    {
+                        cached_luid = desc.luid;
+                        cached_state = 1;
+                        TRACE( "adapter %u vendor %#x luid %s\n", i, desc.vendor_id,
+                               wine_dbgstr_longlong(desc.luid) );
+                    }
+                    ((ULONG (WINAPI *)(void *))(*(void ***)adapter)[2])( adapter );
+                }
+                ((ULONG (WINAPI *)(void *))(*(void ***)factory)[2])( factory );
+            }
+        }
+        if (cached_state < 0) WARN( "no hardware DXGI adapter found for LUID stamping\n" );
+    }
+    *valid = cached_state > 0;
+    return cached_luid;
+}
+
+hipError_t __cdecl hipGetDevicePropertiesR0600( void *props, int device )
+{
+    BOOL luid_valid = FALSE;
+    UINT64 luid = get_dxgi_adapter_luid( &luid_valid );
+    struct hip_params p = {{ ARG(props), (UINT64)device, luid, (UINT64)luid_valid }};
+    return hip_call( unix_hipGetDevicePropertiesR0600, &p );
+}
+
+const char * __cdecl hipGetErrorName( hipError_t error )
+{
+    struct hip_params p = {{ (UINT64)error }};
+    if (WINE_UNIX_CALL( unix_hipGetErrorName, &p ) || !p.ret) return "hipErrorUnknown";
+    return (const char *)(UINT_PTR)p.ret;
+}
