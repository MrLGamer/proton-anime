+/* from hip_runtime_api.h; Windows and Linux layouts match */
+#define HIP_EXT_MEM_OPAQUE_FD      1
+#define HIP_EXT_MEM_OPAQUE_WIN32   2
+#define HIP_EXT_MEM_D3D12_HEAP     4
+#define HIP_EXT_MEM_D3D12_RESOURCE 5
+#define HIP_EXT_MEM_D3D11_RESOURCE 6
