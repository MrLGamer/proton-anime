+/* hipDeviceProp_tR0600 field offsets (stable versioned ABI, x86_64) */
+#define HIP_PROP_LUID_OFFSET      272
+#define HIP_PROP_NODEMASK_OFFSET  280
+
+static NTSTATUS uf_hipGetDevicePropertiesR0600( void *args )
+{
+    struct hip_params *p = args;
+    char *props = PTR(0);
+    const char *luid = getenv( "PROTON_HIP_LUID" );
+    CHECK( hipGetDevicePropertiesR0600 );
+    p->ret = p_hipGetDevicePropertiesR0600( props, INT(1) );
+
+    /* ROCm leaves luid zeroed on Linux, so apps that match the HIP device
+     * to the D3D12 adapter by LUID (to prove same-GPU before sharing memory)
+     * never enable zero-copy interop. On a single-GPU box they are the same
+     * card; stamp the DXGI adapter LUID (detected PE-side, args[2]/[3], or
+     * from PROTON_HIP_LUID) so that match succeeds. */
+    if (!p->ret && props)
+    {
+        if (luid)
+        {
+            unsigned int b[8] = {0}, i, n;
+            n = sscanf( luid, "%2x%2x%2x%2x%2x%2x%2x%2x",
+                        &b[0], &b[1], &b[2], &b[3], &b[4], &b[5], &b[6], &b[7] );
+            for (i = 0; i < 8; i++) props[HIP_PROP_LUID_OFFSET + i] = (i < n) ? (char)b[i] : 0;
+            *(unsigned int *)(props + HIP_PROP_NODEMASK_OFFSET) = 1;
+            TRACE( "stamped device %d luid %s (env)\n", INT(1), luid );
+        }
+        else if (p->args[3])
+        {
+            memcpy( props + HIP_PROP_LUID_OFFSET, &p->args[2], 8 );
+            *(unsigned int *)(props + HIP_PROP_NODEMASK_OFFSET) = 1;
+            TRACE( "stamped device %d luid %#llx (dxgi)\n", INT(1), (unsigned long long)p->args[2] );
+        }
+    }
+    return STATUS_SUCCESS;
+}
