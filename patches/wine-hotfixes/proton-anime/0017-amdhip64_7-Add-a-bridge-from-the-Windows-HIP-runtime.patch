+                             thread_limit, ARG(tid), ARG(bid), ARG(block_dim), ARG(grid_dim), ARG(wsize) }};
+    WINE_UNIX_CALL( unix___hipRegisterFunction, &p );
+}
+
+void __cdecl __hipRegisterVar( void **modules, void *var, char *host_var, char *device_var,
+                               int ext, SIZE_T size, int constant, int global )
