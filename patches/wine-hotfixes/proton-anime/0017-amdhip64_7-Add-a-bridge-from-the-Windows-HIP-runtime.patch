+static NTSTATUS uf_hipImportExternalMemory( void *args )
+{
+    struct hip_params *p = args;
+    const struct hip_ext_mem_desc *desc = CPTR(1);
+    CHECK( hipImportExternalMemory );
+
+    /* the host runtime cannot import D3D12 handle types: shared d3dkmt
+     * objects carry the underlying dmabuf in the server, so retrieve it
+     * and import as an opaque fd instead (zero-copy interop) */
+    if (desc && (desc->type == HIP_EXT_MEM_OPAQUE_WIN32 || desc->type == HIP_EXT_MEM_D3D12_HEAP ||
+                 desc->type == HIP_EXT_MEM_D3D12_RESOURCE || desc->type == HIP_EXT_MEM_D3D11_RESOURCE) &&
+        desc->handle.win32.handle)
+    {
+        /* shared D3D12/D3D11 resources are D3DKMT objects; open the NT handle
+         * and pull its backing dmabuf fd. Fall back to a plain fd-backed handle. */
+        int fd = d3dkmt_handle_to_fd( desc->handle.win32.handle );
+        if (fd < 0)
+        {
+            NTSTATUS status = wine_server_handle_to_fd( desc->handle.win32.handle, GENERIC_ALL, &fd, NULL );
+            if (status) fd = -1;
+        }
+        if (fd >= 0)
+        {
+            struct hip_ext_mem_desc fixed = *desc;
+            fixed.type = HIP_EXT_MEM_OPAQUE_FD;
+            memset( &fixed.handle, 0, sizeof(fixed.handle) );
+            fixed.handle.fd = fd;
+            p->ret = p_hipImportExternalMemory( PTR(0), &fixed );
+            TRACE( "translated d3d type %d handle %p -> fd %d, size %llu: ret %u\n",
+                   desc->type, desc->handle.win32.handle, fd, desc->size, (unsigned int)p->ret );
+            if (p->ret) close( fd );  /* on success the runtime owns the fd */
+            return STATUS_SUCCESS;
+        }
+        WARN( "no unix fd behind shared handle %p\n", desc->handle.win32.handle );
+    }
+
+    p->ret = p_hipImportExternalMemory( PTR(0), CPTR(1) );
+    if (p->ret) WARN( "hipImportExternalMemory failed (%u)\n", (unsigned int)p->ret );
+    return STATUS_SUCCESS;
+}
