+WINE_DEFAULT_DEBUG_CHANNEL(amdhip);
+
+typedef int hipError_t;
+typedef struct { unsigned int x, y, z; } dim3;
+
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    struct hip_params params = {{0}};
+
+    if (reason != DLL_PROCESS_ATTACH) return TRUE;
+    DisableThreadLibraryCalls( inst );
+    if (__wine_init_unix_call()) return FALSE;
+    /* fail the load when there is no usable host HIP runtime, like the
+     * Windows DLL does without an AMD driver */
+    if (WINE_UNIX_CALL( unix_hip_attach, &params ) || !params.ret)
+    {
+        ERR( "no usable host libamdhip64.so.7, failing DLL load\n" );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static UINT64 hip_call( unsigned int code, struct hip_params *params )
+{
+    if (WINE_UNIX_CALL( code, params )) return HIP_ERROR_UNKNOWN;
+    return params->ret;
+}
+
+#define ARG(x) ((UINT64)(UINT_PTR)(x))
+
+hipError_t __cdecl __hipPopCallConfiguration( dim3 *grid, dim3 *block, SIZE_T *shared_mem, void **stream )
+{
+    struct hip_params p = {{ ARG(grid), ARG(block), ARG(shared_mem), ARG(stream) }};
+    return hip_call( unix___hipPopCallConfiguration, &p );
+}
+
+hipError_t __cdecl __hipPushCallConfiguration( dim3 grid, dim3 block, SIZE_T shared_mem, void *stream )
+{
+    struct hip_params p = {{ grid.x, grid.y, grid.z, block.x, block.y, block.z, shared_mem, ARG(stream) }};
+    return hip_call( unix___hipPushCallConfiguration, &p );
+}
+
+void ** __cdecl __hipRegisterFatBinary( const void *data )
+{
+    struct hip_params p = {{ ARG(data) }};
+    if (WINE_UNIX_CALL( unix___hipRegisterFatBinary, &p )) return NULL;
+    return (void **)(UINT_PTR)p.ret;
+}
+
