+static NTSTATUS hip_attach( void *args )
+{
+    struct hip_params *params = args;
+    const char *override = getenv( "PROTON_HIP_LIB" );
+    const char *preload = getenv( "PROTON_HIP_PRELOAD" );
+
+    params->ret = 0;
+    /* dependencies of the host runtime that the Steam Runtime container
+     * lacks (e.g. libnuma), colon-separated */
+    if (preload)
+    {
+        char *copy = strdup( preload ), *tok, *save = NULL;
+        for (tok = strtok_r( copy, ":", &save ); tok; tok = strtok_r( NULL, ":", &save ))
+            if (!dlopen( tok, RTLD_NOW | RTLD_GLOBAL ))
+                WARN( "failed to preload %s: %s\n", tok, dlerror() );
+        free( copy );
+    }
+    dlopen( "libnuma.so.1", RTLD_NOW | RTLD_GLOBAL );
+    if (override) hip_lib = dlopen( override, RTLD_NOW );
+    /* runtime bundled with the build: <lib>/wine/x86_64-unix/../../rocm
+     * ($ORIGIN runpaths make the bundle self-contained) */
+    if (!hip_lib)
+    {
+        Dl_info info;
+        if (dladdr( (void *)hip_attach, &info ) && info.dli_fname)
+        {
+            const char *slash = strrchr( info.dli_fname, '/' );
+            if (slash)
+            {
+                char path[4096];
+                int n = slash - info.dli_fname + 1;
+                if (n < (int)sizeof(path) - 40)
+                {
+                    memcpy( path, info.dli_fname, n );
+                    strcpy( path + n, "../../rocm/libnuma.so.1" );
+                    dlopen( path, RTLD_NOW | RTLD_GLOBAL );
+                    strcpy( path + n, "../../rocm/libamdhip64.so.7" );
+                    hip_lib = dlopen( path, RTLD_NOW );
+                    if (hip_lib) TRACE( "using bundled runtime %s\n", path );
+                }
+            }
+        }
+    }
+    if (!hip_lib) hip_lib = dlopen( "libamdhip64.so.7", RTLD_NOW );
+    if (!hip_lib) hip_lib = dlopen( "/opt/rocm/lib/libamdhip64.so.7", RTLD_NOW );
+    if (!hip_lib)
+    {
+        ERR( "failed to load host HIP runtime: %s\n", dlerror() );
+        return STATUS_SUCCESS;
+    }
+
+#define LOAD_FUNC(f) \
+    if (!(p_##f = dlsym( hip_lib, #f ))) WARN( "%s not found in host HIP runtime\n", #f )
+    LOAD_FUNC( __hipPopCallConfiguration );
+    LOAD_FUNC( __hipPushCallConfiguration );
+    LOAD_FUNC( __hipRegisterFatBinary );
+    LOAD_FUNC( __hipRegisterFunction );
+    LOAD_FUNC( __hipRegisterVar );
+    LOAD_FUNC( __hipUnregisterFatBinary );
+    LOAD_FUNC( hipDestroyExternalMemory );
+    LOAD_FUNC( hipDeviceGetAttribute );
+    LOAD_FUNC( hipDeviceSynchronize );
+    LOAD_FUNC( hipDriverGetVersion );
+    LOAD_FUNC( hipEventCreate );
+    LOAD_FUNC( hipEventCreateWithFlags );
+    LOAD_FUNC( hipEventDestroy );
+    LOAD_FUNC( hipEventElapsedTime );
+    LOAD_FUNC( hipEventQuery );
+    LOAD_FUNC( hipEventRecord );
+    LOAD_FUNC( hipEventSynchronize );
+    LOAD_FUNC( hipExternalMemoryGetMappedBuffer );
+    LOAD_FUNC( hipFree );
+    LOAD_FUNC( hipGetDevice );
+    LOAD_FUNC( hipGetDeviceCount );
+    LOAD_FUNC( hipGetDevicePropertiesR0600 );
+    LOAD_FUNC( hipGetErrorName );
+    LOAD_FUNC( hipGetErrorString );
+    LOAD_FUNC( hipGetLastError );
+    LOAD_FUNC( hipHostFree );
+    LOAD_FUNC( hipHostMalloc );
+    LOAD_FUNC( hipImportExternalMemory );
+    LOAD_FUNC( hipInit );
+    LOAD_FUNC( hipLaunchKernel );
+    LOAD_FUNC( hipMalloc );
+    LOAD_FUNC( hipMemcpy );
+    LOAD_FUNC( hipMemcpyAsync );
+    LOAD_FUNC( hipMemcpyFromSymbol );
+    LOAD_FUNC( hipMemcpyToSymbol );
+    LOAD_FUNC( hipMemset );
+    LOAD_FUNC( hipMemsetAsync );
+    LOAD_FUNC( hipPeekAtLastError );
+    LOAD_FUNC( hipRuntimeGetVersion );
+    LOAD_FUNC( hipSetDevice );
+    LOAD_FUNC( hipStreamCreate );
+    LOAD_FUNC( hipStreamCreateWithFlags );
+    LOAD_FUNC( hipStreamDestroy );
+    LOAD_FUNC( hipStreamQuery );
+    LOAD_FUNC( hipStreamSynchronize );
+#undef LOAD_FUNC
+
+    /* win32u.so sits next to this unixlib; load the d3dkmt fd helpers from it
+     * so we can resolve shared D3D12 buffer handles to their dmabuf fd */
+    {
+        Dl_info info;
+        void *w32u = NULL;
+        if (dladdr( (void *)hip_attach, &info ) && info.dli_fname)
+        {
+            const char *slash = strrchr( info.dli_fname, '/' );
+            if (slash)
+            {
+                char path[4096];
+                int n = slash - info.dli_fname + 1;
+                if (n < (int)sizeof(path) - 16)
+                {
+                    memcpy( path, info.dli_fname, n );
+                    strcpy( path + n, "win32u.so" );
+                    w32u = dlopen( path, RTLD_NOW | RTLD_GLOBAL | RTLD_NOLOAD );
+                    if (!w32u) w32u = dlopen( path, RTLD_NOW | RTLD_GLOBAL );
+                }
+            }
+        }
+        if (!w32u) w32u = dlopen( "win32u.so", RTLD_NOW | RTLD_GLOBAL | RTLD_NOLOAD );
+        if (w32u)
+        {
+            p_d3dkmt_open_resource = dlsym( w32u, "d3dkmt_open_resource" );
+            p_d3dkmt_object_get_fd = dlsym( w32u, "d3dkmt_object_get_fd" );
+        }
+        if (!p_d3dkmt_open_resource || !p_d3dkmt_object_get_fd)
+            WARN( "d3dkmt fd helpers unavailable; shared D3D12 interop limited to fd-backed handles\n" );
+    }
+
+    TRACE( "host HIP runtime loaded\n" );
+    params->ret = 1;
+    return STATUS_SUCCESS;
+}
