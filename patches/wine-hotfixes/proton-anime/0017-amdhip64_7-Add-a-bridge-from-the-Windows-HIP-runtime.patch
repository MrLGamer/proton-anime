+/* win32u helpers to turn a shared D3DKMT NT handle into the backing unix fd,
+ * exported from win32u.so (same conversion winevulkan uses on memory import) */
+static unsigned int (*p_d3dkmt_open_resource)( unsigned int global, void *shared,
+                                               unsigned int *mutex, unsigned int *sync );
+static int (*p_d3dkmt_object_get_fd)( unsigned int local );
+
+static int d3dkmt_handle_to_fd( void *nt_handle )
+{
+    unsigned int mutex = 0, sync = 0, local;
+    if (!p_d3dkmt_open_resource || !p_d3dkmt_object_get_fd) return -1;
+    if (!(local = p_d3dkmt_open_resource( 0, nt_handle, &mutex, &sync ))) return -1;
+    return p_d3dkmt_object_get_fd( local );
+}
