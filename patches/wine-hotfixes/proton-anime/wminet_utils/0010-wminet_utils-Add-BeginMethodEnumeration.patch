From f5100e6d285c87ba9b8c637361cb6b7c889edc70 Mon Sep 17 00:00:00 2001
From: Louis Lenders <xerox.xerox2000x@gmail.com>
Date: Wed, 22 Jul 2026 22:03:07 +0200
Subject: [PATCH] wminet_utils: Add BeginMethodEnumeration.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60036

diff --git a/dlls/wminet_utils/main.c b/dlls/wminet_utils/main.c
index 342f934d..2377a1d5 100644
--- a/dlls/wminet_utils/main.c
+++ b/dlls/wminet_utils/main.c
@@ -128,3 +128,10 @@ HRESULT WINAPI GetNames(int vFunc, IWbemClassObject *ptr, LPCWSTR wszQualifierNa
 
     return IWbemClassObject_GetNames(ptr, wszQualifierName, lFlags, pQualifierVal, pNames);
 }
+
+HRESULT WINAPI BeginMethodEnumeration(int vFunc, IWbemClassObject *ptr, LONG lEnumFlags)
+{
+    TRACE("%i %p %lx\n", vFunc, ptr, lEnumFlags);
+
+    return IWbemClassObject_BeginMethodEnumeration(ptr, lEnumFlags);
+}
diff --git a/dlls/wminet_utils/wminet_utils.spec b/dlls/wminet_utils/wminet_utils.spec
index bd94697e..4cddf19c 100644
--- a/dlls/wminet_utils/wminet_utils.spec
+++ b/dlls/wminet_utils/wminet_utils.spec
@@ -1,5 +1,5 @@
 @ stub BeginEnumeration
-@ stub BeginMethodEnumeration
+@ stdcall BeginMethodEnumeration(long ptr long)
 @ stub BlessIWbemServices
 @ stub BlessIWbemServicesObject
 @ stub Clone
