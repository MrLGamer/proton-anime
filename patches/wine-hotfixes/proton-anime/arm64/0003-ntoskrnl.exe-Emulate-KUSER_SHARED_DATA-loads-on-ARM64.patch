From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrLGamer <mrlgam3r@gmail.com>
Date: Thu, 05 Nov 2026 19:53:18 +0100
Subject: [PATCH] ntoskrnl.exe: Emulate KUSER_SHARED_DATA loads on ARM64.

---
 dlls/ntoskrnl.exe/instr.c    |   34 +++++++++++++++++++++++++++++++++-
 dlls/ntoskrnl.exe/ntoskrnl.c |    2 +-
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/dlls/ntoskrnl.exe/instr.c b/dlls/ntoskrnl.exe/instr.c
--- a/dlls/ntoskrnl.exe/instr.c
+++ b/dlls/ntoskrnl.exe/instr.c
@@ -989,4 +989,36 @@
     return EXCEPTION_CONTINUE_SEARCH;
 }
 
-#endif  /* __x86_64__ */
+#elif defined(__aarch64__)  /* __x86_64__ */
+
+WINE_DEFAULT_DEBUG_CHANNEL(int);
+
+LONG CALLBACK vectored_handler( EXCEPTION_POINTERS *ptrs )
+{
+    EXCEPTION_RECORD *rec = ptrs->ExceptionRecord;
+    CONTEXT *context = ptrs->ContextRecord;
+    ULONG64 offset = rec->ExceptionInformation[1] - 0xfffff78000000000;
+    DWORD instr, size;
+
+    if (rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || rec->ExceptionInformation[0] != EXCEPTION_READ_FAULT)
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    instr = *(DWORD *)context->Pc;
+    size = 1 << (instr >> 30);
+    /* LDR, LDRB, LDRH with an immediate, unscaled or register offset */
+    if ((instr & 0x3fc00000) != 0x39400000 && (instr & 0x3fe00c00) != 0x38400000 &&
+        (instr & 0x3fe00c00) != 0x38600800)
+        return EXCEPTION_CONTINUE_SEARCH;
+    if (offset > KSHARED_USER_DATA_PAGE_SIZE - size) return EXCEPTION_CONTINUE_SEARCH;
+
+    TRACE( "USD offset %#x at pc %#I64x\n", (UINT)offset, context->Pc );
+    if ((instr & 31) != 31)
+    {
+        context->X[instr & 31] = 0;
+        memcpy( &context->X[instr & 31], (BYTE *)0x7ffe0000 + offset, size );
+    }
+    context->Pc += 4;
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+#endif  /* __aarch64__ */
diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -5293,7 +5293,7 @@
     {
     case DLL_PROCESS_ATTACH:
         DisableThreadLibraryCalls( inst );
-#if defined(__i386__) || defined(__x86_64__)
+#if defined(__i386__) || defined(__x86_64__) || defined(__aarch64__)
         handler = RtlAddVectoredExceptionHandler( TRUE, vectored_handler );
 #endif
         KeQueryTickCount( &count );  /* initialize the global KeTickCount */
-- 
2.50.0
