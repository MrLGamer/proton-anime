From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrLGamer <mrlgam3r@gmail.com>
Date: Thu, 05 Nov 2026 19:53:18 +0100
Subject: [PATCH] configure: Build winedevice for ARM64EC.

---
 configure.ac |    1 +
 1 file changed, 1 insertion(+)

diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -2471,6 +2471,7 @@
 enable_netsh=${enable_netsh:-yes}
 enable_regsvr32=${enable_regsvr32:-yes}
 enable_rundll32=${enable_rundll32:-yes}
+enable_winedevice=${enable_winedevice:-yes}
 
 dnl Disable Win16-related modules
 enable_win16=${enable_win16:-i386}
