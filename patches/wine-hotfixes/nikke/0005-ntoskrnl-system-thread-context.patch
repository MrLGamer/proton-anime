From aabd06f0a2cafa2ec7b17ef2be128cd1636c5a32 Mon Sep 17 00:00:00 2001
From: MrLGamer <mrlgam3r@gmail.com>
Date: Sun, 20 Sep 2026 01:43:03 +0200
Subject: [PATCH] ntoskrnl: Set the initial System process context for system
 threads.

---
 dlls/ntoskrnl.exe/ntoskrnl.c | 49 +++++++++++++++++++++++++++++++++---
 1 file changed, 45 insertions(+), 4 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index 36ead75..caaf6ad 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -1082,6 +1082,9 @@ NTSTATUS CDECL wine_ntoskrnl_main_loop( HANDLE stop_event )
 
     /* Set the system process global before setting up the request thread trickery  */
     PsInitialSystemProcess = IoGetCurrentProcess();
+    /* The host winedevice process backs the emulated initial system process. */
+    PsInitialSystemProcess->info.UniqueProcessId = 4;
+    strcpy( PsInitialSystemProcess->imageName, "System" );
     request_thread = GetCurrentThreadId();
 
     pnp_manager_start();
@@ -2708,6 +2711,13 @@ NTSTATUS WINAPI PsLookupProcessByProcessId( HANDLE processid, PEPROCESS *process
 
     TRACE( "(%p %p)\n", processid, process );
 
+    if (processid == ULongToHandle(4) && PsInitialSystemProcess)
+    {
+        *process = PsInitialSystemProcess;
+        ObReferenceObject( *process );
+        return STATUS_SUCCESS;
+    }
+
     if (!(handle = OpenProcess( PROCESS_ALL_ACCESS, FALSE, HandleToUlong(processid) )))
         return STATUS_INVALID_PARAMETER;
 
@@ -3750,6 +3760,27 @@ DEVICE_OBJECT* WINAPI IoGetAttachedDeviceReference( DEVICE_OBJECT *device )
 }
 
 
+struct kernel_thread_start
+{
+    PKSTART_ROUTINE entry;
+    void *context;
+};
+
+static DWORD WINAPI kernel_thread_entry( void *argument )
+{
+    struct kernel_thread_start start = *(struct kernel_thread_start *)argument;
+    struct _KTHREAD *thread = KeGetCurrentThread();
+
+    free( argument );
+    thread->process = PsInitialSystemProcess;
+    thread->id.UniqueProcess = ULongToHandle(4);
+    thread->teb = NULL;
+    KeEnterCriticalRegion();
+    start.entry( start.context );
+    KeLeaveCriticalRegion();
+    return 0;
+}
+
 /***********************************************************************
  *           PsCreateSystemThread   (NTOSKRNL.EXE.@)
  */
@@ -3758,10 +3789,20 @@ NTSTATUS WINAPI PsCreateSystemThread(PHANDLE ThreadHandle, ULONG DesiredAccess,
 			             HANDLE ProcessHandle, PCLIENT_ID ClientId,
                                      PKSTART_ROUTINE StartRoutine, PVOID StartContext)
 {
-    if (!ProcessHandle) ProcessHandle = GetCurrentProcess();
-    return RtlCreateUserThread(ProcessHandle, 0, FALSE, 0, 0,
-                               0, StartRoutine, StartContext,
-                               ThreadHandle, ClientId);
+    struct kernel_thread_start *start;
+    NTSTATUS status;
+
+    if (ProcessHandle || !PsInitialSystemProcess)
+        return RtlCreateUserThread(ProcessHandle ? ProcessHandle : GetCurrentProcess(), 0, FALSE, 0, 0,
+                                   0, StartRoutine, StartContext, ThreadHandle, ClientId);
+    if (!(start = malloc( sizeof(*start) ))) return STATUS_INSUFFICIENT_RESOURCES;
+    start->entry = StartRoutine;
+    start->context = StartContext;
+    status = RtlCreateUserThread( GetCurrentProcess(), 0, FALSE, 0, 0, 0,
+                                  (PRTL_THREAD_START_ROUTINE)kernel_thread_entry, start, ThreadHandle, ClientId );
+    if (status) free( start );
+    else if (ClientId) ClientId->UniqueProcess = ULongToHandle(4);
+    return status;
 }
 
 /***********************************************************************
