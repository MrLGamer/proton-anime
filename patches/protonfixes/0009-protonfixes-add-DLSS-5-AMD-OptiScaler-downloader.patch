 from .utilities import (
     check_verb_requirements,
     setup_frame_rate,
@@ -119,6 +120,7 @@ def execute() -> None:
 __all__ = [
     'setup',
     'execute',
+    'setup_dlss5amd',
     'setup_frame_rate',
