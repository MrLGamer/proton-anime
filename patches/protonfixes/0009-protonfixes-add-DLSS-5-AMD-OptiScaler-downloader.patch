 __init__.py |   2 +
 dlss5amd.py | 234 ++++++++++++++++++++++++++++++++
 2 files changed, 236 insertions(+)
 create mode 100644 dlss5amd.py

diff --git a/__init__.py b/__init__.py
--- a/__init__.py
+++ b/__init__.py
@@ -10,6 +10,7 @@ from .logger import log
 from .upscalers import setup_upscalers
 from .xxmi import setup_xxmi
 from .reshade import setup_reshade
